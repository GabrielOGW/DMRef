# ── Banco (Neon, via integração da Vercel) ────────────────────────────────
# Não preencha à mão: rode `vercel env pull`, que escreve o bloco completo do
# Neon em .env. Só estas duas importam para o código:
#
#   DATABASE_URL           pooled  — usada pelo runtime (src/db/index.ts)
#   DATABASE_URL_UNPOOLED  direta  — usada por migração/DDL (drizzle.config.ts)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Better Auth (PR 2) — estas sim entram à mão ───────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
